# Voice Clone Pro Official - Environment Configuration Template

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Channel & Group Membership Gate
REQUIRED_CHANNEL_ID=-1001234567890
REQUIRED_GROUP_ID=-1009876543210
CHANNEL_INVITE_LINK=https://t.me/your_channel_link
GROUP_INVITE_LINK=https://t.me/your_group_link

# Database Configuration (Isolated Local SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./data/voice_clone_official.db

# Character Limits per Generation
CHARACTER_LIMIT_FREE=120
CHARACTER_LIMIT_PURCHASED=500

# Applio Engine Configuration
APPLIO_WORKDIR=C:\Applio
APPLIO_PYTHON=C:\Applio\env\python.exe
APPLIO_RUNNER=C:\Applio\infer-web.py
APPLIO_COMMAND=

# Tutorial & Support
TUTORIAL_VIDEO_LINK=https://t.me/voiceclonepro/tutorial

# Logging
LOG_LEVEL=INFO

# Groq Cloud Ultra-Fast Whisper Speech-to-Text API
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
