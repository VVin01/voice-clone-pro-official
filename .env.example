# Voice Clone Pro Official - Environment Configuration Template
# Copy to .env and fill in your own values. Never commit a real .env file.
# Placeholders below are NOT real secrets.

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=123456789,987654321

# App environment: development | production
# Set APP_ENV=production on Render so gate warnings use production wording.
APP_ENV=development
PORT=8000
RUN_MODE=all
# Run modes (main.py --mode, or RUN_MODE / APP_MODE env): all, bot, worker,
# web, web_and_bot, bot_and_web. "all" runs bot polling + worker + web server.

# Internal worker token (NEW, security branch): a random value, set to the
# SAME value on Render and on any laptop worker. If empty, the bot token
# is used as a fallback with a warning - do not rely on that long term.
WORKER_TOKEN=YOUR_RANDOM_WORKER_TOKEN

# Channel & Group Membership Gate - REQUIRED on Render.
# If REQUIRED_CHANNEL_ID or REQUIRED_GROUP_ID is missing on the live
# service, the gate fails CLOSED: every gated Mini App write returns
# 403 GATE_NOT_CONFIGURED. On live main (fail-open) a missing ID silently
# passed everyone - that was the bypass.
# The bot must be an admin of both the channel and the group, otherwise
# get_chat_member cannot verify members.
REQUIRED_CHANNEL_ID=-1001234567890
REQUIRED_GROUP_ID=-1009876543210
CHANNEL_INVITE_LINK=https://t.me/your_channel_link
GROUP_INVITE_LINK=https://t.me/your_group_link

# Database Configuration
# Code default (app/config/settings.py): voice_clone_v2.db
# WARNING: on Render, a local SQLite file is lost on redeploy/restart
# unless a persistent disk is attached. Confirm in the Render Dashboard
# whether DATABASE_URL points to Render Postgres or to local SQLite
# before relying on this service for balances and payment requests.
DATABASE_URL=sqlite+aiosqlite:///./data/voice_clone_v2.db
LEGACY_DATABASE_URL=sqlite+aiosqlite:///./data/voice_clone_official.db
EXPECTED_DB_IDENTITY=voice_clone_v2

# Character Limits per Generation (code defaults - do not use the old 120/500)
CHARACTER_LIMIT_FREE=1000
CHARACTER_LIMIT_PURCHASED=5000
INFRASTRUCTURE_SAFETY_CHARACTER_LIMIT=5000

# Daily / concurrency limits (code defaults)
FREE_DAILY_JOB_LIMIT=5
PURCHASED_DAILY_JOB_LIMIT=0
MAX_CONCURRENT_JOBS_PER_USER=1

# Monthly / bonus allowances (seconds, code defaults)
FREE_MONTHLY_ALLOWANCE_SECONDS=180

# Plans — three separate categories, single source of truth PLAN_CATALOGUE in
# app/services/payments.py (see docs/PLANS.md). Do not change a price in one
# place alone, or UI and backend will disagree:
# Voice-only: MIN_10 8000 / MIN_30 20000 / MIN_60 38000 / Voice Pro 75000 (250 min).
# Recap-only: Recap Starter 20000 (5 credits) / Recap Pro 90000 (25 credits).
# Combined: Combined Starter 30000 (30 min + 5 credits) / Master 180000 (500 min + 60 credits).
WELCOME_BONUS_SECONDS=0

# Recap limits (seconds, code defaults)
RECAP_FREE_MAX_DURATION_SECONDS=120
RECAP_MAX_DURATION_SECONDS=600

# Job recovery (seconds, code default 1800 - not 600)
STALE_JOB_TIMEOUT_SECONDS=1800
MAINTENANCE_MODE=false

# Voice v2: no legacy trained-model engine. Voice clone is VoxCPM2 only.
# Use a short reference audio (3-30s) to clone a voice zero-shot.
# Legacy .pth models are rejected with a clear message, not queued.
# Tutorial & Support
TUTORIAL_VIDEO_LINK=https://t.me/voiceclonepro/tutorial
TUTORIAL_VIDEO_ENABLED=true
TUTORIAL_VOICE_LINK=https://t.me/VoiceClonePro/16
TUTORIAL_VOICE_ENABLED=true
TUTORIAL_RECAP_LINK=https://t.me/VoiceClonePro/16
TUTORIAL_RECAP_ENABLED=true

# Logging
LOG_LEVEL=INFO

# Groq Cloud Ultra-Fast Whisper STT — primary (key rotation: GROQ_API_KEYS, then GROQ_API_KEY)
# Fallback order: Groq -> local faster-whisper (WHISPER_*) -> clear error, never silent wrong text.
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_API_KEYS=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# VoxCPM 2 Neural TTS & Voice Cloning (OpenBMB)
VOXCPM_SPACE_URL=openbmb/VoxCPM-Demo
VOXCPM_SPACES=
VOXCPM_TIMEOUT=60
HF_TOKEN=YOUR_HF_TOKEN
HF_TOKENS=

# Gemini AI (read directly from env in gemini_recap.py / recap_engine -
# not via settings fields, so it must be listed here explicitly)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEYS=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_1=gemini-3.5-flash
GEMINI_FALLBACK_2=gemini-3.5-flash-lite
GEMINI_FALLBACK_3=gemini-flash-lite-latest
# Image-project keys are read as GEMINI_IMAGE_PROJECT_<N>_KEY in
# recap_engine/recap_planner.py (N = 1, 2, ... in numeric order).
GEMINI_IMAGE_PROJECT_1_KEY=

# Whisper / transcription (read directly from env in transcriber.py)
WHISPER_MODEL=base
WHISPER_BACKEND=auto
WHISPER_DEVICE=cpu

# Downloader cookies (optional, read directly from env in downloader.py)
YOUTUBE_COOKIES=
DOUYIN_COOKIES=
COOKIES_FILE=
COOKIES_CONTENT=

# Mini App / Render external URLs (optional, read directly from env)
RENDER_EXTERNAL_URL=
MINI_APP_URL=

# Payment accounts — set via env or admin dynamic settings, never hardcoded in code.
PAYMENT_KPAY_NUMBER=
PAYMENT_KPAY_NAME=
PAYMENT_WAVE_NUMBER=
PAYMENT_WAVE_NAME=

# Final release prices (see docs/PLANS.md): Voice-only 8000/20000/38000/75000 MMK;
# Recap-only 20000/90000 MMK; Combined 30000/180000 MMK.
# Payment env must be filled before deploy or payment display will be blank.
